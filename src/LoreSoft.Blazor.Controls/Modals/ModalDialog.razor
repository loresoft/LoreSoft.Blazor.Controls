@namespace LoreSoft.Blazor.Controls

<dialog id="@Modal.ModalId"
        class="@ClassName"
        style="@Style"
        closedby="any"
        aria-modal="true"
        aria-labelledby="@Modal.TitleId"
        aria-describedby="@Modal.BodyId"
        @ref="Element">
    <DynamicComponent Type="@Modal.ComponentType"
                      Parameters="@Modal.Parameters" />
</dialog>


