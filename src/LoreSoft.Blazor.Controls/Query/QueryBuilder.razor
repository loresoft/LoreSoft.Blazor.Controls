@namespace LoreSoft.Blazor.Controls

@using Microsoft.AspNetCore.Components.Web

<CascadingValue IsFixed="true" Value="this" Name="QueryBuilder">
    <CascadingValue IsFixed="true" Value="CurrentFieldCollection" Name="QueryFieldCollection">
        @if (QueryFields != null)
        {
            @QueryFields
        }
        <div class="query-builder">
            <QueryBuilderGroup Group="RootQuery" />
            @if (FooterTemplate != null)
            {
                @FooterTemplate
            }
        </div>
    </CascadingValue>
</CascadingValue>
